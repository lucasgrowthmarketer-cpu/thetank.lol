# MongoDB (Railway plugin or Atlas)
MONGODB_URI=mongodb://localhost:27017/aquarium
# Stripe (leave empty to run in DEMO mode: actions are applied for free, no payment)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Public URL of the site (used for Stripe redirects and OG image)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret to delete a fish (moderation): DELETE /api/admin?key=...&fish=<id>
ADMIN_KEY=change-me
